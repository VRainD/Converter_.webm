APP_PORT=8080
LOG_LEVEL=INFO
# Maximum upload size in MB (51200 = 50 GB)
MAX_UPLOAD_MB=51200
# Streaming write chunk size during upload (MB)
UPLOAD_CHUNK_MB=8
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_HOURS=48
TEMP_RETENTION_HOURS=6
ENABLE_ADVANCED_OPTIONS=true
DEFAULT_OUTPUT_FORMAT=mp4
DEFAULT_QUALITY_PROFILE=balanced
GIF_MAX_DURATION_SEC=120
# ffprobe timeout for large files (seconds)
FFPROBE_TIMEOUT_SEC=600
# ffmpeg job timeout — 72 h default for multi-GB sources
FFMPEG_TIMEOUT_SEC=259200
CORS_ORIGINS=*
DEBUG=false
